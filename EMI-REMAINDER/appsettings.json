{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Hangfire": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "${DefaultConnection}"
  },
  "Jwt": {
    "Key": "${Jwt__Key}",
    "Issuer": "${Jwt__Issuer}",
    "Audience": "${Jwt__Audience}",
    "ExpiryDays": 30
  },
  "Twilio": {
    "AccountSid": "${Twilio__AccountSid}",
    "AuthToken": "${Twilio__AuthToken}",
    "FromNumber": "${Twilio__FromNumber}"
  },
  "Razorpay": {
    "KeyId": "${Razorpay__KeyId}",
    "KeySecret": "${Razorpay__KeySecret}",
    "Plans": {
      "monthly": 9900,
      "yearly": 79900
    }
  },
  "IpRateLimiting": {
    "EnableEndpointRateLimiting": true,
    "StackBlockedRequests": false,
    "RealIpHeader": "X-Real-IP",
    "ClientIdHeader": "X-ClientId",
    "HttpStatusCode": 429,
    "GeneralRules": [
      {
        "Endpoint": "*",
        "Period": "1m",
        "Limit": 100
      },
      {
        "Endpoint": "post:/api/auth/send-otp",
        "Period": "1h",
        "Limit": 5
      }
    ]
  }
}
